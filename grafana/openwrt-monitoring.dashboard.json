      "title": "System",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\",mode=\"idle\"}[5m])))*100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "CPU Used [System]",
      "type": "stat",
      "description": "Показывает общую загрузку CPU.\n\n- Единица: %"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} / node_memory_MemTotal_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"})*100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "RAM Used [System]",
      "type": "stat",
      "description": "Показывает долю используемой оперативной памяти.\n\n- Единица: %"
    },
    {
      "id": 16,
      "title": "CPU Modes [System]",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=\"system\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(rate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy System"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=\"user\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(rate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy User"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=\"iowait\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(rate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy Iowait"
        },
        {
          "refId": "D",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"irq|softirq\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(rate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy IRQs"
        },
        {
          "refId": "E",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode!~\"idle|user|system|iowait|irq|softirq\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(rate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy Other"
        }
      ],
      "description": "Показывает распределение загрузки CPU по режимам.\n\n- `user` — пользовательские процессы\n- `system` — системные процессы\n- `iowait` — ожидание операций ввода-вывода\n- `IRQ` — обработка аппаратных и программных прерываний\n- `other` — остальные режимы\n- Единица: %"
    },
    {
      "id": 19,
      "title": "RAM Composition [System]",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} - node_memory_MemFree_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} - node_memory_Buffers_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} - node_memory_Cached_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} - node_memory_Slab_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} - node_memory_PageTables_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"} - node_memory_SwapCached_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "legendFormat": "Apps"
        },
        {
          "refId": "B",
          "expr": "node_memory_PageTables_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "legendFormat": "PageTables"
        },
        {
          "refId": "C",
          "expr": "node_memory_SwapCached_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "legendFormat": "SwapCache"
        },
        {
          "refId": "D",
          "expr": "node_memory_Slab_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "legendFormat": "Slab"
        },
        {
          "refId": "E",
          "expr": "node_memory_Cached_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "legendFormat": "Cache"
        },
        {
          "refId": "F",
          "expr": "node_memory_Buffers_bytes{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "legendFormat": "Buffers"
        }
      ],
      "description": "Показывает распределение используемой RAM по компонентам.\n\n- `Apps` — память приложений и процессов\n- `Buffers` — буферы ядра\n- `Cache` — файловый кэш\n- `Slab` — структуры ядра\n- `PageTables` — таблицы страниц\n- `SwapCache` — данные в кэше swap\n- Единица: bytes"
    },
