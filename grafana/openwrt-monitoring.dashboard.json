        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "up{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Status",
      "type": "stat",
      "description": "Показывает доступность экспортера роутера.\n\n- Значение `1` — UP\n- Значение `0` — DOWN"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "suffix: days",
          "decimals": 1,
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(time() - node_boot_time_seconds{job=\"openwrt-monitoring\",instance=\"$instance\"}) / 86400",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat",
      "description": "Показывает время работы роутера с момента последней перезагрузки.\n\n- Единица: days"
    },
